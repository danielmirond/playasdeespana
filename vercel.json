{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/sync-playas",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/warm?slice=landings",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/warm?slice=geo",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/warm?slice=top",
      "schedule": "45 */12 * * *"
    },
    {
      "path": "/api/cron/warm?slice=meteo&n=250",
      "schedule": "20 6-21/3 * * *"
    },
    {
      "path": "/api/cron/vigia",
      "schedule": "0 17 * * *"
    }
  ],
  "env": {
    "NEXT_PUBLIC_BASE_URL": "https://playas-espana.com"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://playas-espana.com"
        }
      ]
    }
  ]
}
